# Database Configuration
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kamenja_db"

# Environment
NODE_ENV="development"

# Set to "true" only if you must run a production build (NODE_ENV=production)
# over plain HTTP — e.g. testing `next build && next start` locally, or a
# deployment that isn't behind HTTPS yet. Browsers refuse to store cookies
# marked Secure over an insecure connection, which silently breaks the admin
# session cookie (and therefore bulk import, the only route that checks it)
# even though login appears to succeed. Leave unset/false on real HTTPS deployments.
ADMIN_COOKIE_INSECURE="false"

# Cloudinary (required for bulk-import image uploads — src/lib/cloudinary.ts).
# Without these set, any row with images will fail to upload (rows without
# images are unaffected). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
